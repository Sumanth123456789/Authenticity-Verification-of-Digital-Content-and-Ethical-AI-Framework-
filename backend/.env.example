# AI-Content Verification Hub — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────
# Port for FastAPI backend (default: 8000)
BACKEND_PORT=8000

# Frontend URL for CORS (Vite dev server)
FRONTEND_URL=http://localhost:3000

# Debug mode (set to false in production)
DEBUG=true

# ─── Database ─────────────────────────────────────────────
# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./aicvhub.db

# ─── File Upload ──────────────────────────────────────────
# Maximum upload file size in bytes (default: 500MB)
MAX_UPLOAD_SIZE_BYTES=524288000

# Temporary directory for uploaded files
TEMP_UPLOAD_DIR=./tmp_uploads

# Auto-cleanup temp files after analysis (seconds, 0 = immediate)
TEMP_FILE_TTL_SECONDS=300

# ─── AI Models — HuggingFace (Optional, improves accuracy) ─
# Get a free token at https://huggingface.co/settings/tokens
# Leave empty to use local models only
HUGGINGFACE_API_TOKEN=

# HuggingFace inference API base URL
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models

# ─── External APIs (Optional, all have free tiers) ────────
# Google Safe Browsing API — https://developers.google.com/safe-browsing
# Free tier: 10,000 requests/day. Leave empty to skip safe browsing check.
GOOGLE_SAFE_BROWSING_API_KEY=

# ─── Whisper Transcription ────────────────────────────────
# Model size: tiny, base, small, medium (default: small — multilingual)
# tiny = 39MB CPU-fast | base = 74MB | small = 244MB (recommended)
WHISPER_MODEL_SIZE=small

# Device for inference: cpu (default for no GPU)
INFERENCE_DEVICE=cpu

# ─── Risk Engine ──────────────────────────────────────────
# Minimum confidence threshold to flag as suspicious (0-100)
SUSPICIOUS_THRESHOLD=35

# Minimum confidence threshold to flag as high risk (0-100)
HIGH_RISK_THRESHOLD=55
